{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/konzultace/:tema([a-z]+)",
      "destination": "/konzultace"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/clanek?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kadlec-partneri.vercel.app"
        }
      ],
      "destination": "https://kadlec-partneri.cz/:path*",
      "permanent": true
    },
    {
      "source": "/klientska-zona",
      "destination": "/klientsky-portal/",
      "permanent": false
    },
    {
      "source": "/k/:tema([a-z]+)/:kanal([a-z0-9-]+)",
      "destination": "/konzultace/:tema?utm_source=:kanal&utm_medium=kratky-odkaz&utm_campaign=:tema",
      "permanent": false
    },
    {
      "source": "/k/:tema([a-z]+)",
      "destination": "/konzultace/:tema?utm_source=kratky-odkaz&utm_medium=kratky-odkaz&utm_campaign=:tema",
      "permanent": false
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "query",
          "key": "clanek",
          "value": "(?<id>[A-Za-z0-9]{20})"
        }
      ],
      "destination": "/blog/:id",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://www.gstatic.com https://apis.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://api.emailjs.com https://www.gstatic.com; frame-src https://blog-adbe8.firebaseapp.com https://apis.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/klientsky-portal/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/klientsky-portal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(llms|robots).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
